# Copy to .env for local development. Never commit real secrets.

# Required for speaker diarization.
HF_TOKEN=

# Required when LLM_PROVIDER=gemini.
GEMINI_API_KEY=

# Optional movie metadata lookup.
TMDB_API_KEY=

# Runtime defaults.
CONFIG_PATH=config.yaml
ML_DEVICE=auto
OUTPUT_DIR=data/processed
VIDEO_DATA_PATH=data/videos
SPEAKER_UI_MODE=external
SPEAKER_MAP_TIMEOUT_SECONDS=3600

# Service networking.
API_HOST=localhost
API_PORT=1234
SEARCH_API_TIMEOUT_SECONDS=10
UI_HOST=0.0.0.0
UI_PORT=5050
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_COLLECTION=video_search_engine
CHROMA_IMAGE_TAG=1.5.6
RABBITMQ_IMAGE_TAG=4.1.4-management
RABBITMQ_DEFAULT_USER=video_se
RABBITMQ_DEFAULT_PASS=video_se_dev
# Host-side publisher and worker commands require this URL.
RABBITMQ_URL=amqp://video_se:video_se_dev@localhost:5672/%2F
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
STREAMLIT_PORT=8501
SPEAKER_UI_PORT=5050
INGESTION_QUEUE=video.ingestion

# LLM provider.
LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-2.5-flash
OLLAMA_HOST=http://localhost
OLLAMA_PORT=11434
OLLAMA_MODEL=gemma:2b

# Local model cache.
MODEL_CACHE_DIR=.models

# Logging verbosity for CLI entrypoints (CRITICAL/ERROR/WARNING/INFO/DEBUG).
LOG_LEVEL=INFO

# Log output format. `pretty` is colorized human-readable (default).
# `json` emits one JSON object per line for machine consumption — set
# this in production so log shippers can index `request_id` and `level`.
LOG_FORMAT=pretty

# --- Optional security ---
# Set SEARCH_API_KEY to require X-API-Key on /search. Leaving it blank
# keeps the API open (suitable for a trusted local network).
SEARCH_API_KEY=
# Comma-separated CORS allow-list. Blank means no CORS middleware is
# attached at all (browsers can't cross-origin call the API).
CORS_ALLOW_ORIGINS=
# Reject /search bodies larger than this many bytes (default 32 KiB).
MAX_REQUEST_BODY_BYTES=
# Per-client request limit on /search (60-second sliding window). 0 / blank
# disables. Keys are derived from X-API-Key when present, else
# X-Forwarded-For first hop, else direct peer IP.
RATE_LIMIT_PER_MINUTE=
